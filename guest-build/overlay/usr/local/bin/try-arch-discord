#!/usr/bin/env python3
"""Relay an existing app's Discord Rich Presence through Try Arch on Windows."""
import os
import selectors
import socket
import sys


def relay(local, host):
    with selectors.DefaultSelector() as selector:
        selector.register(local, selectors.EVENT_READ, host)
        selector.register(host, selectors.EVENT_READ, local)
        while True:
            for event, _ in selector.select():
                data = event.fileobj.recv(65536)
                if not data:
                    return
                event.data.sendall(data)


def main():
    # systemd Accept=yes supplies the connected per-user Unix socket on stdin.
    with socket.socket(fileno=os.dup(0)) as local:
        with socket.create_connection(('10.0.2.2', 4457), timeout=5) as host:
            host.settimeout(None)
            relay(local, host)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError) as error:
        sys.exit(f'Discord bridge: {error}')
